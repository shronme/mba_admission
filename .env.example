ENV=development
LOG_LEVEL=INFO

# Local docker-compose URLs.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mba_admissions
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_TASK_DEFAULT_QUEUE=default

# Health endpoint extra checks (defaults to false for CI friendliness).
HEALTHCHECK_DB=false
HEALTHCHECK_REDIS=false

# Comma-separated origins for the real Next.js app (browser → API).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000

# --- Program dossier research (`backend/scripts/research_program_dossiers.py`) ---
# Copy to `.env` at the repo root or `backend/.env` (see script; shell env wins over file).
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=perplexity/sonar-pro
# Optional: different model for per-school program discovery (defaults to PERPLEXITY_MODEL).
PERPLEXITY_MODEL_DISCOVERY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
CYCLE_YEAR=
PROGRAM_DOSSIER_SLEEP_SECONDS=1.0
PROGRAM_DOSSIER_LIMIT=0
PROGRAM_DOSSIER_DISCOVERY_LIMIT=0
PROGRAM_DOSSIER_OUT_DIR=
# When Perplexity returns no programs for a school, discovery retries with OpenAI (optional).
OPENAI_API_KEY=
PROGRAM_DISCOVERY_OPENAI_MODEL=openai/gpt-4o-mini

# Admission evaluation (Celery task: Perplexity dossier research + OpenAI evaluation JSON).
# Optional override for evaluation calls (defaults to openai/gpt-4o-mini).
OPENAI_EVAL_MODEL=
